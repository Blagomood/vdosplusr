
//#include "afxres.h"
#include "windows.h"

// icon resource
vDosPlus_ico ICON "vdos.ico"

// version resource
VS_VERSION_INFO VERSIONINFO
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Spevakov"
            VALUE "FileDescription", "vDosPlusR - DOS for Windows"
            VALUE "FileVersion", "1"
            VALUE "InternalName", "vDosPlusR"
            VALUE "LegalCopyright", "© 2026 Spevakov"
            VALUE "OriginalFilename", "vDosPlusR.exe"
            VALUE "ProductName", "vDosPlusR - Virtual DOS for Windows"
            VALUE "ProductVersion", "2026, 10, 09"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
